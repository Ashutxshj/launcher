# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Where every finished leads sheet is emailed. NEVER an office inbox.
LAUNCHER_RECIPIENT=you@example.com

# Resend API key used to email you the sheet. Get one at resend.com.
RESEND_API_KEY=re_your_key_here
RESEND_FROM=Chillispark Leads <onboarding@resend.dev>

LAUNCHER_PORT=8765
